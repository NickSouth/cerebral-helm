{
  "schemaVersion": "1.0.0",
  "id": "note.search",
  "version": "1.0.0",
  "purpose": "Search filenames, metadata, and Markdown note content without making search the durable source of truth.",
  "inputSchema": {
    "schemaId": "https://cerebralhelm.local/schemas/tools/note-search-input.schema.json",
    "schemaVersion": "1.0.0"
  },
  "outputSchema": {
    "schemaId": "https://cerebralhelm.local/schemas/tools/note-search-output.schema.json",
    "schemaVersion": "1.0.0"
  },
  "risk": "read_only",
  "runtimeRiskPolicy": "descriptor_risk",
  "confirmationPolicyKey": "allow_read_without_confirmation",
  "requiredPermissions": ["knowledge_root_read"],
  "secretReferences": [],
  "timeoutMs": 5000,
  "retry": {
    "maxAttempts": 0,
    "strategy": "none"
  },
  "cancellable": true,
  "idempotency": "idempotent",
  "adapterRequirements": {
    "capabilities": ["note.search"],
    "platforms": ["pre_mac_mock", "macos_native"]
  },
  "logging": {
    "redactionPaths": ["/query"],
    "retention": "standard"
  },
  "results": ["success", "partial_success", "unavailable", "timeout", "failure", "cancelled"],
  "availability": {
    "preMac": true,
    "macOS": true
  }
}
