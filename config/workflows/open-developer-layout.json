{
  "schemaVersion": "1.0.0",
  "id": "open-developer-layout",
  "label": "Open Developer Layout",
  "steps": [
    { "id": "snapshot-system", "label": "Snapshot system status", "tool": "system.status.read" },
    { "id": "open-editor", "label": "Open editor", "tool": "app.open", "input": { "appId": "vscode" } },
    { "id": "open-terminal", "label": "Open terminal", "tool": "app.open", "input": { "appId": "terminal" } },
    { "id": "open-claude", "label": "Open Claude Desktop", "tool": "app.open", "input": { "appId": "claude-desktop" } },
    { "id": "open-repo", "label": "Open repository", "tool": "url.open", "input": { "urlId": "github" } },
    { "id": "run-dev-hook", "label": "Run dev setup hook", "tool": "hook.run", "input": { "hookId": "ondraft-dev" } },
    {
      "id": "arrange-windows",
      "label": "Arrange editor and Claude side by side",
      "tool": "window.arrange",
      "input": {
        "arrangement": [
          { "appId": "vscode", "frame": "left-two-thirds" },
          { "appId": "claude-desktop", "frame": "right-third" }
        ]
      }
    }
  ]
}
