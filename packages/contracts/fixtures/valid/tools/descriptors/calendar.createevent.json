{
  "schemaVersion": "1.0.0",
  "id": "calendar.createevent",
  "version": "1.0.0",
  "purpose": "Create one event in the user's calendar at a given local start and end time.",
  "inputSchema": {
    "schemaId": "https://cerebralhelm.local/schemas/tools/calendar-create-event-input.schema.json",
    "schemaVersion": "1.0.0"
  },
  "outputSchema": {
    "schemaId": "https://cerebralhelm.local/schemas/tools/calendar-create-event-output.schema.json",
    "schemaVersion": "1.0.0"
  },
  "risk": "external_write",
  "runtimeRiskPolicy": "descriptor_risk",
  "confirmationPolicyKey": "allow_external_write_when_user_authored",
  "requiredPermissions": ["calendar_write"],
  "secretReferences": [],
  "timeoutMs": 15000,
  "retry": {
    "maxAttempts": 0,
    "strategy": "none"
  },
  "cancellable": false,
  "idempotency": "non_idempotent",
  "adapterRequirements": {
    "capabilities": ["calendar.write"],
    "platforms": ["macos_native"]
  },
  "logging": {
    "redactionPaths": ["/notes"],
    "retention": "standard"
  },
  "results": ["success", "unavailable", "timeout", "failure", "denied"],
  "availability": {
    "preMac": false,
    "macOS": true
  }
}
