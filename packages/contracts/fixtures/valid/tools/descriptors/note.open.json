{
  "schemaVersion": "1.0.0",
  "id": "note.open",
  "version": "1.0.0",
  "purpose": "Open one Markdown note in the user's Markdown editor by its root-relative path, without ever resolving outside the knowledge root.",
  "inputSchema": {
    "schemaId": "https://cerebralhelm.local/schemas/tools/note-open-input.schema.json",
    "schemaVersion": "1.0.0"
  },
  "outputSchema": {
    "schemaId": "https://cerebralhelm.local/schemas/tools/note-open-output.schema.json",
    "schemaVersion": "1.0.0"
  },
  "risk": "local_write",
  "runtimeRiskPolicy": "descriptor_risk",
  "confirmationPolicyKey": "confirm_local_write",
  "requiredPermissions": ["knowledge_root_read", "application_launch"],
  "secretReferences": [],
  "timeoutMs": 30000,
  "retry": {
    "maxAttempts": 0,
    "strategy": "none"
  },
  "cancellable": false,
  "idempotency": "idempotent",
  "adapterRequirements": {
    "capabilities": ["note.open"],
    "platforms": ["macos_native"]
  },
  "logging": {
    "redactionPaths": ["/notePath"],
    "retention": "standard"
  },
  "results": ["success", "unavailable", "denied", "timeout", "failure"],
  "availability": {
    "preMac": false,
    "macOS": true
  }
}
