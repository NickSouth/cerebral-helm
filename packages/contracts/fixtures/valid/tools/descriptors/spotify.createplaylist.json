    "schemaId": "https://cerebralhelm.local/schemas/tools/spotify-create-playlist-input.schema.json",
    "schemaVersion": "1.0.0"
  },
  "outputSchema": {
    "schemaId": "https://cerebralhelm.local/schemas/tools/spotify-create-playlist-output.schema.json",
    "schemaVersion": "1.0.0"
  },
  "risk": "external_write",
