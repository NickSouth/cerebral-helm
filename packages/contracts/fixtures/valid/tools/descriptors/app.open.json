{
  "schemaVersion": "1.0.0",
  "id": "app.open",
  "version": "1.0.0",
  "purpose": "Open a configured application reference through the platform adapter.",
  "inputSchema": {
    "schemaId": "https://cerebralhelm.local/schemas/tools/app-open-input.schema.json",
    "schemaVersion": "1.0.0"
  },
  "outputSchema": {
    "schemaId": "https://cerebralhelm.local/schemas/tools/app-open-output.schema.json",
    "schemaVersion": "1.0.0"
  },
  "risk": "local_write",
  "runtimeRiskPolicy": "descriptor_risk",
  "confirmationPolicyKey": "confirm_local_write",
  "requiredPermissions": ["application_launch"],
  "secretReferences": [],
  "timeoutMs": 30000,
  "retry": {
    "maxAttempts": 0,
    "strategy": "none"
  },
  "cancellable": false,
  "idempotency": "idempotent",
  "adapterRequirements": {
    "capabilities": ["app.open"],
    "platforms": ["macos_native"]
  },
  "logging": {
    "redactionPaths": [],
    "retention": "standard"
  },
  "results": ["success", "unavailable", "denied", "timeout", "failure"],
  "availability": {
    "preMac": false,
    "macOS": true
  }
}
