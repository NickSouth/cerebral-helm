{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerebralhelm.local/schemas/bridge/bootstrap-state.schema.json",
  "title": "CerebralHelm Bridge Bootstrap State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "mode",
    "project",
    "summary",
    "commandsToday",
    "pendingConfirmations",
    "uiState",
    "heimlich",
    "expandedAgent",
    "modes",
    "agents",
    "regions"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "mode": {
      "title": "Mode",
      "type": "string",
      "enum": ["Executive", "Developer", "School", "Entertainment"]
    },
    "project": { "type": "string" },
    "summary": { "type": "string" },
    "commandsToday": { "type": "integer", "minimum": 0 },
    "pendingConfirmations": { "type": "integer", "minimum": 0 },
    "weather": {
      "title": "DashboardWeatherChannel",
      "description": "Ambient weather for the persistent bottom bar. Optional (a Mac-only capability; mocked pre-Mac).",
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "label"],
      "properties": {
        "state": {
          "title": "DashboardRegionState",
          "type": "string",
          "enum": ["ready", "empty", "stale", "unavailable"]
        },
        "label": { "type": "string" },
        "temperatureF": { "type": "number", "description": "Temperature in °F, when known." },
        "condition": { "type": "string", "description": "Short condition phrase, e.g. \"Partly Cloudy\"." }
      }
    },
    "uiState": {
      "title": "UIState",
      "type": "string",
      "enum": ["loading", "empty", "stale", "unavailable", "offline", "error", "confirmation", "success", "cancelled", "ready"]
    },
    "heimlich": {
      "title": "DashboardHeimlich",
      "description": "The center surface — Heimlich's consciousness — present in every mode; the center is never replaced (design spec §5.7). The chat/conversation overlay was removed for the MVP (NIC-124): conversing with Heimlich is post-MVP, so only the runtime `state` remains.",
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {
          "title": "DashboardHeimlichState",
          "type": "string",
          "enum": ["idle", "listening", "thinking", "acting", "awaiting_confirmation", "success", "error", "offline"]
        }
      }
    },
    "expandedAgent": {
      "description": "The agent whose right-column-width workspace panel is open over the right column, or null. Defaults to null in every mode — Heimlich owns the center and nothing is expanded by default (design spec §5.10).",
      "type": ["string", "null"]
    },
    "modes": {
      "description": "All four resolved mode views, shipped eagerly so a mode switch re-themes instantly without a bridge round-trip or theme flash (NIC-117 d). The active mode is identified by the top-level `mode`.",
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "title": "DashboardModeView",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "theme", "quickApps", "quickActions", "widgets"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "theme": {
            "title": "DashboardModeTheme",
            "type": "object",
            "additionalProperties": false,
            "required": ["accentPrimary", "accentSecondary"],
            "properties": {
              "accentPrimary": { "type": "string" },
              "accentSecondary": { "type": "string" }
            }
          },
          "quickApps": { "type": "array", "items": { "type": "string" } },
          "quickActions": {
            "description": "Exactly 8 ordered slots; an id or null for an unconfigured slot (rendered as an honest disabled placeholder pre-wiring).",
            "type": "array",
            "minItems": 8,
            "maxItems": 8,
            "items": { "type": ["string", "null"] }
          },
          "widgets": {
            "title": "DashboardModeWidgets",
            "type": "object",
            "additionalProperties": false,
            "required": ["left", "right"],
            "properties": {
              "left": { "type": "string" },
              "right": { "type": "string" }
            }
          },
          "greeting": {
            "title": "DashboardModeGreeting",
            "type": "object",
            "additionalProperties": false,
            "required": ["persona", "fallback"],
            "properties": {
              "persona": { "type": "string" },
              "directive": { "type": "string" },
              "fallback": { "type": "string" }
            }
          },
          "calendarProfile": { "type": "string" },
          "newsProfile": { "type": "string" }
        }
      }
    },
    "agents": {
      "description": "The fixed global agent roster, identical in every mode (design spec §5.10). No add-agent capability.",
      "type": "array",
      "items": {
        "title": "DashboardAgentSummary",
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "summary", "availability", "activity"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "summary": { "type": "string" },
          "availability": {
            "title": "DashboardAgentAvailability",
            "description": "The configured availability flag (agent config `status`); not the runtime dashboard state.",
            "type": "string",
            "enum": ["mock", "disabled", "unavailable", "enabled"]
          },
          "activity": {
            "title": "DashboardAgentActivity",
            "description": "The runtime dashboard status (design spec §5.10); event-driven, defaults to idle in bootstrap.",
            "type": "string",
            "enum": ["idle", "waiting", "thinking", "ready"]
          }
        }
      }
    },
    "regions": {
      "title": "DashboardRegions",
      "description": "The active mode's region data (schedule, system health, news, left/right widgets). Heavy data is resolved on switch, not shipped eagerly for every mode.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schedule", "systemHealth", "news", "widgets"],
      "properties": {
        "schedule": {
          "title": "DashboardScheduleRegion",
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "items"],
          "properties": {
            "state": {
              "title": "DashboardRegionState",
              "type": "string",
              "enum": ["ready", "empty", "stale", "unavailable"]
            },
            "items": {
              "type": "array",
              "items": {
                "title": "DashboardScheduleItem",
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "kind"],
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "start": { "type": "string" },
                  "kind": {
                    "title": "DashboardScheduleKind",
                    "type": "string",
                    "enum": ["today", "tonight"]
                  }
                }
              }
            },
            "emptyMessage": { "type": "string" }
          }
        },
        "systemHealth": {
          "title": "DashboardSystemHealthRegion",
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "battery"],
          "properties": {
            "state": {
              "title": "DashboardRegionState",
              "type": "string",
              "enum": ["ready", "empty", "stale", "unavailable"]
            },
            "cpuPercent": { "type": "number" },
            "memoryPercent": { "type": "number" },
            "network": {
              "title": "DashboardNetworkChannel",
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "label"],
              "properties": {
                "state": {
                  "title": "DashboardRegionState",
                  "type": "string",
                  "enum": ["ready", "empty", "stale", "unavailable"]
                },
                "label": { "type": "string" },
                "linkMbps": { "type": "number", "description": "Wi-Fi link (transmit) rate in Mbps — the connection's speed, when known." }
              }
            },
            "battery": {
              "title": "DashboardBatteryChannel",
              "type": "object",
              "additionalProperties": false,
              "required": ["state", "label"],
              "properties": {
                "state": {
                  "title": "DashboardRegionState",
                  "type": "string",
                  "enum": ["ready", "empty", "stale", "unavailable"]
                },
                "label": { "type": "string" },
                "percent": { "type": "number", "minimum": 0, "maximum": 100, "description": "Charge level 0–100, when known (Mac-only capability)." },
                "charging": { "type": "boolean", "description": "Whether the battery is currently charging, when known (Mac-only capability)." },
                "pluggedIn": { "type": "boolean", "description": "Whether the machine is on external power, when known (a full battery on AC is plugged in but not charging)." }
              }
            }
          }
        },
        "news": {
          "title": "DashboardNewsRegion",
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "headlines"],
          "properties": {
            "state": {
              "title": "DashboardRegionState",
              "type": "string",
              "enum": ["ready", "empty", "stale", "unavailable"]
            },
            "headlines": {
              "type": "array",
              "maxItems": 3,
              "items": {
                "title": "DashboardNewsHeadline",
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "title", "source"],
                "properties": {
                  "id": { "type": "string" },
                  "title": { "type": "string" },
                  "source": { "type": "string" }
                }
              }
            },
            "emptyMessage": { "type": "string" }
          }
        },
        "widgets": {
          "title": "DashboardRegionWidgets",
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": { "$ref": "#/$defs/widgetData" },
            "right": { "$ref": "#/$defs/widgetData" }
          }
        }
      }
    }
  },
  "$defs": {
    "widgetData": {
      "title": "DashboardWidgetData",
      "description": "The common widget-data envelope (mirrors apps/dashboard/src/widgets/widgetData.ts). The per-widget payload is the open `data` object.",
      "type": "object",
      "additionalProperties": false,
      "required": ["widgetId", "state"],
      "properties": {
        "widgetId": { "type": "string" },
        "state": {
          "title": "DashboardRegionState",
          "type": "string",
          "enum": ["ready", "empty", "stale", "unavailable"]
        },
        "headline": { "type": "string" },
        "data": { "type": "object", "additionalProperties": true },
        "freshness": {
          "title": "DashboardWidgetFreshness",
          "type": "object",
          "additionalProperties": false,
          "required": ["observedAt", "label"],
          "properties": {
            "observedAt": { "type": "string" },
            "label": { "type": "string" }
          }
        },
        "emptyMessage": { "type": "string" },
        "action": {
          "title": "DashboardWidgetAction",
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "label"],
          "properties": {
            "id": { "type": "string" },
            "label": { "type": "string" }
          }
        }
      }
    }
  }
}
