{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerebralhelm.local/schemas/bridge/event.schema.json",
  "title": "CerebralHelm Bridge Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "type",
    "timestamp",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^brevt_[A-Za-z0-9_-]{8,64}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "command.lifecycle.transition",
        "config.changed",
        "mode.quickapps.changed",
        "settings.changed",
        "confirmation.changed",
        "bridge.capability.changed",
        "system.status.changed",
        "system.checks.changed",
        "workflow.action.progress",
        "display.topology.changed",
        "layout.session.changed",
        "mode.windowcollapse.changed",
        "widget.data.changed",
        "weather.changed",
        "news.changed",
        "mail.changed",
        "schedule.changed",
        "apps.changed"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
