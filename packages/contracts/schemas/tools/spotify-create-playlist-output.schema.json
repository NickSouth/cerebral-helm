{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerebralhelm.local/schemas/tools/spotify-create-playlist-output.schema.json",
  "title": "CerebralHelm Spotify Create Playlist Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["playlistID", "playlistName"],
  "properties": {
    "playlistID": {
      "type": "string",
      "minLength": 1
    },
    "playlistName": {
      "type": "string",
      "minLength": 1
    },
    "playlistURL": {
      "type": "string",
      "description": "The playlist's Spotify URL as returned by the API — never constructed here. Absent when Spotify omitted it."
    }
  }
}
