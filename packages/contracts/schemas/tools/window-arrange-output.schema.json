{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerebralhelm.local/schemas/tools/window-arrange-output.schema.json",
  "title": "CerebralHelm Window Arrange Output",
  "description": "Per-entry arrangement results (NIC-88): apps that are not running or do not expose a controllable window report partial results, never a silent skip or a fabricated success.",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "entries"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["arranged", "partial"]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["appId", "frame", "status"],
        "properties": {
          "appId": {
            "type": "string",
            "minLength": 1
          },
          "frame": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["arranged", "not_running", "unsupported", "unknown_app", "failed"]
          },
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
