{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerebralhelm.local/schemas/tools/web-open-output.schema.json",
  "title": "CerebralHelm Web Open Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["url", "opened"],
  "properties": {
    "url": {
      "type": "string",
      "minLength": 1,
      "description": "The https web address that was opened."
    },
    "opened": {
      "type": "boolean"
    }
  }
}
