{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerebralhelm.local/schemas/tools/note-capture-output.schema.json",
  "title": "CerebralHelm Note Capture Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["noteId", "path", "created"],
  "properties": {
    "noteId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "created": {
      "type": "boolean"
    }
  }
}
