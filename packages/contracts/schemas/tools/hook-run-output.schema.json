{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerebralhelm.local/schemas/tools/hook-run-output.schema.json",
  "title": "CerebralHelm Hook Run Output",
  "type": "object",
  "additionalProperties": false,
  "required": ["hookId", "exitCode", "stdout", "stderr", "timedOut", "durationMs"],
  "properties": {
    "hookId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 1
    },
    "exitCode": {
      "type": "integer"
    },
    "stdout": {
      "type": "string"
    },
    "stderr": {
      "type": "string"
    },
    "timedOut": {
      "type": "boolean"
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
