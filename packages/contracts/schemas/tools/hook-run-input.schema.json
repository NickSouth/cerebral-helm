{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerebralhelm.local/schemas/tools/hook-run-input.schema.json",
  "title": "CerebralHelm Hook Run Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["hookId"],
  "properties": {
    "hookId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "minLength": 1
    }
  }
}
