{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerebralhelm.local/schemas/config/agent.schema.json",
  "title": "CerebralHelm Agent Surface Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "status", "summary"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["mock", "disabled", "unavailable", "enabled"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "allowedKnowledgeRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*(/[a-z][a-z0-9-]*)*$"
      },
      "uniqueItems": true
    },
    "allowedToolIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^x-[a-z][a-z0-9-]*$"
      },
      "additionalProperties": true
    }
  }
}
