{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerebralhelm.local/schemas/config/mode.schema.json",
  "title": "CerebralHelm Mode Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "label", "theme", "quickApps", "quickActions", "widgets"],
  "properties": {
    "id": {
      "$ref": "#/$defs/configId"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accentPrimary", "accentSecondary"],
      "properties": {
        "accentPrimary": {
          "$ref": "#/$defs/themeToken"
        },
        "accentSecondary": {
          "$ref": "#/$defs/themeToken"
        }
      }
    },
    "quickApps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/configId"
      },
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true
    },
    "quickActions": {
      "description": "Exactly 8 ordered quick-action slots forming the binding 4+4 ambient grid (slots 0-3 render as compact bars, 4-7 as boxes; the shared shell owns that geometry). Each slot is an action id or null for an unconfigured slot (rendered as an 'add action' button). Non-null ids must be unique; null slots may repeat.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/actionSlot"
      },
      "minItems": 8,
      "maxItems": 8
    },
    "widgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "left": {
          "$ref": "#/$defs/configId"
        },
        "right": {
          "$ref": "#/$defs/configId"
        }
      }
    },
    "projectHints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "calendarProfile": {
      "type": "string",
      "enum": ["all", "engineering", "academic", "leisure"]
    },
    "newsProfile": {
      "type": "string",
      "enum": ["broad", "engineering", "academic", "interest"]
    },
    "greeting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["persona", "fallback"],
      "properties": {
        "persona": {
          "type": "string",
          "minLength": 1
        },
        "directive": {
          "type": "string",
          "minLength": 1
        },
        "fallback": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "layoutId": {
      "$ref": "#/$defs/layoutId"
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "configId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "actionSlot": {
      "type": ["string", "null"],
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "themeToken": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
    },
    "layoutId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)*$"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^x-[a-z][a-z0-9-]*$"
      },
      "additionalProperties": true
    }
  }
}
