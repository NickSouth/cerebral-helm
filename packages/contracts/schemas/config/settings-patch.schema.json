{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cerebralhelm.local/schemas/config/settings-patch.schema.json",
  "title": "CerebralHelm Settings Patch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "patchId", "changes"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "patchId": {
      "type": "string",
      "pattern": "^set_[A-Za-z0-9_-]{8,64}$"
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultModeId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "confirmAllActions": {
          "type": "boolean"
        },
        "appearance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "density": {
              "type": "string",
              "enum": ["comfortable", "compact"]
            },
            "reducedMotion": {
              "type": "boolean"
            },
            "assistantName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "hotkeys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "commandPalette": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "knowledge": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rootReference": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "windowsStoredByMode": {
              "type": "boolean"
            },
            "mainDisplayId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "modeColors": {
          "type": "object",
          "propertyNames": {
            "pattern": "^(executive|developer|school|entertainment)\\.(primary|secondary)$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "extensions": {
          "type": "object",
          "propertyNames": {
            "pattern": "^x-[a-z][a-z0-9-]*$"
          },
          "additionalProperties": true
        }
      }
    }
  }
}
